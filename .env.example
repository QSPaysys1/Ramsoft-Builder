# Copy to .env and fill in. .env is gitignored.

# Google Gemini (Google AI Studio) API key — powers /api/llm/* note generation.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Optional. If set, /api/llm/* is proxied to this host instead of using Gemini.
# LLM_API_UPSTREAM=https://your-backend-host

# --- Uploads: /api/upload (server-only secrets) -----------------------------

# Cloudflare Images (https://dash.cloudflare.com → Images)
CF_ACCOUNT_ID=
CF_IMAGES_API_TOKEN=
CF_IMAGES_DELIVERY_HASH=        # the hash in imagedelivery.net/{HASH}/...

# Cloudflare R2 (S3-compatible)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=                    # https://<CF_ACCOUNT_ID>.r2.cloudflarestorage.com (defaults from CF_ACCOUNT_ID)
R2_PUBLIC_URL=                  # custom domain or public bucket URL, e.g. https://files.example.com

# Supabase server-side (service role bypasses RLS for the uploads insert)
SUPABASE_URL=                   # https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
